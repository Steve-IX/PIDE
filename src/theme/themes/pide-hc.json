    "terminal.background": "#000000",
    "terminal.foreground": "#ffffff",
    "terminal.ansiBlack": "#000000",
    "terminal.ansiRed": "#ff6b6b",
    "terminal.ansiGreen": "#3dd68c",
    "terminal.ansiYellow": "#f38518",
    "terminal.ansiBlue": "#6fc3df",
    "terminal.ansiMagenta": "#c792ea",
    "terminal.ansiCyan": "#22d3ee",
    "terminal.ansiWhite": "#ffffff",
    "terminal.ansiBrightBlack": "#888888",
    "terminal.ansiBrightRed": "#ff8a8a",
    "terminal.ansiBrightGreen": "#5eeba8",
    "terminal.ansiBrightYellow": "#ffaa44",
    "terminal.ansiBrightBlue": "#8fd4ef",
    "terminal.ansiBrightMagenta": "#d8b4fe",
    "terminal.ansiBrightCyan": "#67e8f9",
    "terminal.ansiBrightWhite": "#ffffff",
    "terminalCursor.foreground": "#f38518",
    "gitDecoration.modifiedResourceForeground": "#f38518",
    "gitDecoration.untrackedResourceForeground": "#3dd68c",
    "gitDecoration.deletedResourceForeground": "#ff6b6b"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#888888", "fontStyle": "italic" }
    },
    {
      "scope": ["string", "string.quoted"],
      "settings": { "foreground": "#3dd68c" }
    },
    {
      "scope": ["constant.numeric", "constant.language"],
      "settings": { "foreground": "#f38518" }
    },
    {
      "scope": ["keyword", "keyword.control", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#6fc3df" }
    },
    {
      "scope": ["entity.name.function", "support.function"],
      "settings": { "foreground": "#22d3ee" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "support.class"],
      "settings": { "foreground": "#f38518" }
    },
    {
      "scope": ["variable"],
      "settings": { "foreground": "#ffffff" }
    },
    {
      "scope": ["entity.name.tag"],
      "settings": { "foreground": "#ff6b6b" }
    },
    {
      "scope": ["invalid"],
      "settings": { "foreground": "#ff6b6b" }
    }
  ]
}
