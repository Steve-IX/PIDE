    "tab.inactiveBackground": "#eef2f7",
    "tab.inactiveForeground": "#64748b",
    "tab.border": "#d0d8e4",
    "tab.activeBorderTop": "#2563eb",
    "panel.background": "#f8fafc",
    "panel.border": "#d0d8e4",
    "panelTitle.activeForeground": "#0f172a",
    "panelTitle.inactiveForeground": "#64748b",
    "statusBar.background": "#1d4ed8",
    "statusBar.foreground": "#f8fafc",
    "statusBar.border": "#00000000",
    "statusBar.noFolderBackground": "#1d4ed8",
    "statusBarItem.hoverBackground": "#ffffff22",
    "titleBar.activeBackground": "#e8eef6",
    "titleBar.activeForeground": "#0f172a",
    "button.background": "#2563eb",
    "button.foreground": "#ffffff",
    "button.hoverBackground": "#1d4ed8",
    "button.secondaryBackground": "#e2e8f0",
    "button.secondaryForeground": "#1e293b",
    "input.background": "#ffffff",
    "input.foreground": "#1e293b",
    "input.border": "#cbd5e1",
    "input.placeholderForeground": "#94a3b8",
    "dropdown.background": "#ffffff",
    "dropdown.foreground": "#1e293b",
    "dropdown.border": "#cbd5e1",
    "badge.background": "#2563eb",
    "badge.foreground": "#ffffff",
    "scrollbarSlider.background": "#94a3b866",
    "scrollbarSlider.hoverBackground": "#64748b88",
    "scrollbarSlider.activeBackground": "#475569aa",
    "editorWidget.background": "#ffffff",
    "editorWidget.border": "#cbd5e1",
    "quickInput.background": "#ffffff",
    "quickInput.foreground": "#1e293b",
    "quickInputList.focusBackground": "#dbeafe",
    "notifications.background": "#ffffff",
    "notifications.foreground": "#1e293b",
    "notifications.border": "#cbd5e1",
    "notificationCenterHeader.background": "#f4f7fb",
    "textLink.foreground": "#1d4ed8",
    "terminal.background": "#ffffff",
    "terminal.foreground": "#1e293b",
    "terminal.ansiBlack": "#0f172a",
    "terminal.ansiRed": "#dc2626",
    "terminal.ansiGreen": "#16a34a",
    "terminal.ansiYellow": "#ca8a04",
    "terminal.ansiBlue": "#2563eb",
    "terminal.ansiMagenta": "#9333ea",
    "terminal.ansiCyan": "#0891b2",
    "terminal.ansiWhite": "#64748b",
    "terminal.ansiBrightBlack": "#475569",
    "terminal.ansiBrightRed": "#ef4444",
    "terminal.ansiBrightGreen": "#22c55e",
    "terminal.ansiBrightYellow": "#eab308",
    "terminal.ansiBrightBlue": "#3b82f6",
    "terminal.ansiBrightMagenta": "#a855f7",
    "terminal.ansiBrightCyan": "#06b6d4",
    "terminal.ansiBrightWhite": "#0f172a",
    "terminalCursor.foreground": "#2563eb",
    "gitDecoration.modifiedResourceForeground": "#ca8a04",
    "gitDecoration.untrackedResourceForeground": "#16a34a",
    "gitDecoration.deletedResourceForeground": "#dc2626"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#64748b", "fontStyle": "italic" }
    },
    {
      "scope": ["string", "string.quoted"],
      "settings": { "foreground": "#15803d" }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character"],
      "settings": { "foreground": "#b45309" }
    },
    {
      "scope": ["keyword", "keyword.control", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#1d4ed8" }
    },
    {
      "scope": ["entity.name.function", "support.function"],
      "settings": { "foreground": "#0e7490" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "support.class", "support.type"],
      "settings": { "foreground": "#a16207" }
    },
    {
      "scope": ["variable", "variable.other", "variable.parameter"],
      "settings": { "foreground": "#1e293b" }
    },
    {
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#dc2626" }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#b45309" }
    },
    {
      "scope": ["meta.preprocessor", "keyword.control.directive"],
      "settings": { "foreground": "#7e22ce" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#dc2626" }
    }
  ]
}
