    "sideBar.background": "#f4f7fb",
    "sideBar.foreground": "#334155",
    "sideBar.border": "#d0d8e4",
    "sideBarTitle.foreground": "#64748b",
    "sideBarSectionHeader.background": "#f4f7fb",
    "sideBarSectionHeader.foreground": "#64748b",
    "list.hoverBackground": "#e2e8f0",
    "list.activeSelectionBackground": "#dbeafe",
    "list.activeSelectionForeground": "#0f172a",
    "list.inactiveSelectionBackground": "#e2e8f0",
    "list.focusBackground": "#dbeafe",
    "editor.background": "#ffffff",
    "editor.foreground": "#1e293b",
    "editor.lineHighlightBackground": "#f1f5f9",
    "editor.selectionBackground": "#2563eb33",
    "editor.inactiveSelectionBackground": "#2563eb18",
    "editorCursor.foreground": "#2563eb",
    "editorWhitespace.foreground": "#cbd5e1",
    "editorLineNumber.foreground": "#94a3b8",
