    "terminal.foreground": "#d7dde8",
    "terminal.ansiBlack": "#0d1118",
    "terminal.ansiRed": "#f87171",
    "terminal.ansiGreen": "#4ade80",
    "terminal.ansiYellow": "#fbbf24",
    "terminal.ansiBlue": "#60a5fa",
    "terminal.ansiMagenta": "#c084fc",
    "terminal.ansiCyan": "#22d3ee",
    "terminal.ansiWhite": "#d7dde8",
    "terminal.ansiBrightBlack": "#6b7588",
    "terminal.ansiBrightRed": "#fca5a5",
    "terminal.ansiBrightGreen": "#86efac",
    "terminal.ansiBrightYellow": "#fde68a",
    "terminal.ansiBrightBlue": "#93c5fd",
    "terminal.ansiBrightMagenta": "#d8b4fe",
    "terminal.ansiBrightCyan": "#67e8f9",
    "terminal.ansiBrightWhite": "#f1f5f9",
    "terminalCursor.foreground": "#3d7eff",
    "gitDecoration.modifiedResourceForeground": "#fbbf24",
    "gitDecoration.untrackedResourceForeground": "#4ade80",
    "gitDecoration.deletedResourceForeground": "#f87171"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#6b7588", "fontStyle": "italic" }
    },
    {
      "scope": ["string", "string.quoted"],
      "settings": { "foreground": "#86efac" }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character"],
      "settings": { "foreground": "#fbbf24" }
    },
    {
      "scope": ["keyword", "keyword.control", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#93c5fd" }
    },
    {
      "scope": ["entity.name.function", "support.function"],
      "settings": { "foreground": "#67e8f9" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "support.class", "support.type"],
      "settings": { "foreground": "#fde68a" }
    },
    {
      "scope": ["variable", "variable.other", "variable.parameter"],
      "settings": { "foreground": "#d7dde8" }
    },
    {
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#f87171" }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#fbbf24" }
    },
    {
      "scope": ["meta.preprocessor", "keyword.control.directive"],
      "settings": { "foreground": "#c084fc" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#f87171" }
    }
  ]
}
